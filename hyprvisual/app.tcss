Screen {
    background: $background;
    align: center middle;
}

#display-list {
    width: 65%;
    height: 100%;
    margin-top: 1;
    margin-bottom: 1;
    content-align: center middle;
    align: center top;
}

/* ── Display Cards ─────────────────────────── */
.display-container {
    height: 8;
    margin: 1 0;
    padding: 1 2;
    border: vkey $surface;
    background: $surface;
    align: left middle;
    transition: border 300ms, background 300ms;
}

.display-container:hover {
    background: $panel;
}

.display-container.focused {
    border: vkey $accent;
    background: $panel;
}

.status-icon {
    width: 8;
    height: 100%;
    content-align: center middle;
    text-style: bold;
    color: $success;
    margin-right: 2;
}

.display-info {
    width: 2fr;
    height: 100%;
    align: left middle;
}

.display-name {
    text-style: bold;
    color: $text;
}

.display-desc {
    color: $text-muted;
    text-style: italic;
    margin-top: 1;
}

.display-hints {
    width: 1fr;
    height: 100%;
    align: right middle;
    margin-right: 2;
}

.hint-label {
    color: $text-muted;
    text-align: right;
    margin-bottom: 1;
}

Switch {
    margin-top: 2;
}

/* ── Modals shared ─────────────────────────── */
#mirror-dialog, #hz-dialog, #position-dialog, #profile-dialog, #scale-dialog, #workspace-dialog {
    width: 62%;
    height: auto;
    padding: 2 4;
    border: vkey $accent;
    background: $surface;
}

#confirm-dialog {
    width: 50%;
    height: auto;
    padding: 2 4;
    border: vkey $warning;
    background: $surface;
    align: center middle;
}

#mirror-title, #hz-title, #position-title, #profile-title, #scale-title, #workspace-title {
    text-style: bold;
    color: $accent;
    padding-bottom: 1;
}

#confirm-title {
    text-style: bold;
    color: $warning;
    padding-bottom: 1;
}

#mirror-prompt, #hz-prompt, #position-prompt, #position-current, #confirm-timer, #profile-prompt, #scale-prompt, #workspace-prompt {
    color: $text-muted;
    padding-bottom: 1;
}

#mirror-options, #hz-options, #profile-list, #scale-options {
    height: 18;
    overflow-y: auto;
    margin-top: 1;
}

.modal-btn { margin-bottom: 1; }

#profile-input-row {
    height: 3;
    margin-top: 1;
    margin-bottom: 1;
}

#profile-input {
    width: 2fr;
    margin-right: 1;
}

.profile-item {
    height: 3;
    padding-right: 1;
    align: left middle;
}

.profile-name {
    width: 1fr;
    color: $text;
}

.btn-load { margin-right: 1; }

#confirm-buttons, #position-buttons, #position-buttons-y, #workspace-buttons {
    height: auto;
    align: center middle;
    padding-top: 1;
}

#confirm-buttons Button, #position-buttons Button, #position-buttons-y Button, #workspace-buttons Button { margin: 0 2; }

#workspace-input-row {
    height: 3;
    margin-top: 1;
    margin-bottom: 1;
}
#workspace-input {
    width: 2fr;
}
